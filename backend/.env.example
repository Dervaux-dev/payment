PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mypayment
MERCHANT_ID=merchant-demo
SHOP_API_KEY=replace-with-a-long-random-value
LND_REST_ENDPOINT=https://127.0.0.1:8081
LND_REST_CERT=/path/to/tls.cert
LND_REST_MACAROON=replace-with-restricted-macaroon-hex
PLATFORM_FEE_BPS=100
RATE_LOCK_SECONDS=900
COINGECKO_API_URL=https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd&include_last_updated_at=true
COINGECKO_MAX_AGE_SECONDS=1800
FX_API_URL=https://open.er-api.com/v6/latest/USD
FX_MAX_AGE_SECONDS=172800

# --- myShopApp callback ---
# After a Lightning payment settles, mypayment will call myShopApp to confirm the sale.
# Set to the base URL of your myShopApp backend API.
MYSHOPAPP_API_URL=http://localhost:5000
# Must match PAYMENT_API_KEY in myShopApp's backend .env
MYSHOPAPP_PAYMENT_KEY=change_me_to_a_long_random_string
